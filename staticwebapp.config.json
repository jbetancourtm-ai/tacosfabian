{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/api/auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/reviews/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/movements/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/sales-summary/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/caja",
      "rewrite": "/caja.html"
    },
    {
      "route": "/caja/*",
      "rewrite": "/caja.html"
    },
    {
      "route": "/admin",
      "rewrite": "/admin.html",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/admin/*",
      "rewrite": "/admin.html",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/admin.html",
      "allowedRoles": [
        "admin"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/github?post_login_redirect_uri=/admin"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/caja",
      "/caja/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/favicon.ico",
      "/assets/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
